{
  "name": "@retroz/to-md",
  "version": "0.2.0",
  "description": "Fetch any web page and print its main content as clean, LLM-friendly Markdown straight to your terminal.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "markdown",
    "html",
    "cli",
    "llm",
    "extract",
    "readability",
    "scraper",
    "web"
  ],
  "homepage": "https://github.com/RetrozDev/to-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetrozDev/to-md.git"
  },
  "bugs": {
    "url": "https://github.com/RetrozDev/to-md/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "to-md": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "domhandler": "^5.0.3",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.5",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.7"
  }
}
